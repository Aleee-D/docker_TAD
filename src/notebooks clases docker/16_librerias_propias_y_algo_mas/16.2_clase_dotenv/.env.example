# ─────────────────────────────────────────────────────────────
# .env.example — PLANTILLA de variables de entorno
#
# 1. Copiá este archivo y renombralo a  .env
# 2. Completá tus valores reales en el .env
# 3. El .env NUNCA se sube a GitHub ni se entrega (está en .gitignore)
#    Este .env.example SÍ se sube: muestra qué variables hacen falta.
# ─────────────────────────────────────────────────────────────

# API de Polygon (datos de mercado) — https://polygon.io
POLYGON_API_KEY=

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Configuración general
MODO_DEBUG=false
